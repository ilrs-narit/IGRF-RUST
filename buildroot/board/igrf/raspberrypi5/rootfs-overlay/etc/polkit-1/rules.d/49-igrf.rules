// Kiosk has no login session; authorize its dedicated identity explicitly.
polkit.addRule(function(action, subject) {
    if (subject.user !== "igrf") return;
    var network = [
        "org.freedesktop.NetworkManager.network-control",
        "org.freedesktop.NetworkManager.settings.modify.system",
        "org.freedesktop.NetworkManager.enable-disable-network",
        "org.freedesktop.NetworkManager.enable-disable-wifi",
        "org.freedesktop.NetworkManager.wifi.scan"
    ];
    if (network.indexOf(action.id) !== -1) return polkit.Result.YES;
    // Only start the validated eject helper, not arbitrary systemd services.
    if (action.id === "org.freedesktop.systemd1.manage-units" &&
        action.lookup("verb") === "start" &&
        /^igrf-usb-eject@sd[a-z]+[0-9]*\.service$/.test(action.lookup("unit")))
        return polkit.Result.YES;
});
