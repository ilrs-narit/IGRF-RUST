#!/bin/sh
set -eu
export DISPLAY=:0
export GDK_BACKEND=x11
export HOME=/data/igrf
export XAUTHORITY=/run/igrf-x11/Xauthority
export DBUS_SESSION_BUS_ADDRESS=unix:path=/run/igrf-x11/bus

# Both Onboard and the independent app service use this same fixed bus.
dbus-daemon --session --address="$DBUS_SESSION_BUS_ADDRESS" --fork
onboard &
matchbox-window-manager -use_titlebar no &
wm_pid=$!
systemd-notify --ready
wait "$wm_pid"
