config BR2_PACKAGE_IGRF_APP
	bool "igrf-app"
	depends on BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS
	select BR2_PACKAGE_HOST_RUSTC
	# The rfd gtk3 backend (map-grid file dialog) links GTK3 at runtime;
	# the app forces GDK_BACKEND=x11, so the X11 GDK backend is required.
	# The rest of the X11/GL platform stack (XORG7, mesa3d V3D, WM) is
	# pre-written by the defconfig (issue #16), not selected here.
	select BR2_PACKAGE_LIBGTK3
	select BR2_PACKAGE_LIBGTK3_X11
	help
	  IGRF magnetic field kiosk application
