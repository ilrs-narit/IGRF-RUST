config BR2_PACKAGE_PYTHON_DISTUTILS_EXTRA
	bool "python-distutils-extra"
	depends on BR2_PACKAGE_PYTHON3
	select BR2_PACKAGE_PYTHON_SETUPTOOLS
	help
	  Distutils helpers for translations and desktop resources.
	  Onboard uses the host variant at build time.

	  https://salsa.debian.org/python-team/packages/python-distutils-extra
